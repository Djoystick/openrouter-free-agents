# OpenRouter API Key (Get your free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: HTTP/HTTPS Proxy (required if OpenRouter is restricted in your region/ISP)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Optional: Application metadata sent to OpenRouter
APP_NAME=OpenRouter Free Agents Swarm
APP_REFERER=https://github.com/your-username/openrouter-free-agents

# Default timeout in seconds for agent calls
DEFAULT_TIMEOUT=90
